# Port the Express server listens on
PORT=4000

# JWT Secret Key used for signing and verifying JSON Web Tokens
JWT_SECRET=

# MongoDB connection string for connecting to the database
MONGODB_URL=

# Verified sender email address for outgoing mail (Brevo)
MAIL_USER=

# Brevo (transactional email API) API key
BREVO_API_KEY=

# Cloudinary credentials for media/file uploads
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=

# Razorpay credentials for course payments
RAZORPAY_KEY=
RAZORPAY_SECRET=
